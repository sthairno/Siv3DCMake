{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux (Debug)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux (Release)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS (Debug)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/Debug",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "VCPKG_TARGET_TRIPLET": "x64-osx"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS (Release)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/Release",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "VCPKG_TARGET_TRIPLET": "x64-osx"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows (Debug)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/Debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDebug",
        "CMAKE_WIN32_EXECUTABLE": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows (Release)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/Release",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "CMAKE_WIN32_EXECUTABLE": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-linux-debug",
      "displayName": "Build Siv3DApp (Linux, Debug)",
      "configurePreset": "linux-debug",
      "targets": [
        "Siv3DApp"
      ]
    },
    {
      "name": "build-linux-release",
      "displayName": "Build Siv3DApp (Linux, Release)",
      "configurePreset": "linux-release",
      "targets": [
        "Siv3DApp"
      ]
    },
    {
      "name": "build-macos-debug",
      "displayName": "Build Siv3DApp (macOS, Debug)",
      "configurePreset": "macos-debug",
      "configuration": "Debug",
      "targets": [
        "Siv3DApp"
      ]
    },
    {
      "name": "build-macos-release",
      "displayName": "Build Siv3DApp (macOS, Release)",
      "configurePreset": "macos-release",
      "configuration": "Release",
      "targets": [
        "Siv3DApp"
      ]
    },
    {
      "name": "build-windows-debug",
      "displayName": "Build Siv3DApp (Windows, Debug)",
      "configurePreset": "windows-debug",
      "targets": [
        "Siv3DApp"
      ]
    },
    {
      "name": "build-windows-release",
      "displayName": "Build Siv3DApp (Windows, Release)",
      "configurePreset": "windows-release",
      "targets": [
        "Siv3DApp"
      ]
    }
  ],
  "workflowPresets": [
    {
      "name": "workflow-linux-debug",
      "displayName": "Configure and Build Siv3DApp (Linux, Debug)",
      "steps": [
        {
          "type": "configure",
          "name": "linux-debug"
        },
        {
          "type": "build",
          "name": "build-linux-debug"
        }
      ]
    },
    {
      "name": "workflow-linux-release",
      "displayName": "Configure and Build Siv3DApp (Linux, Release)",
      "steps": [
        {
          "type": "configure",
          "name": "linux-release"
        },
        {
          "type": "build",
          "name": "build-linux-release"
        }
      ]
    },
    {
      "name": "workflow-macos-debug",
      "displayName": "Configure and Build Siv3DApp (macOS, Debug)",
      "steps": [
        {
          "type": "configure",
          "name": "macos-debug"
        },
        {
          "type": "build",
          "name": "build-macos-debug"
        }
      ]
    },
    {
      "name": "workflow-macos-release",
      "displayName": "Configure and Build Siv3DApp (macOS, Release)",
      "steps": [
        {
          "type": "configure",
          "name": "macos-release"
        },
        {
          "type": "build",
          "name": "build-macos-release"
        }
      ]
    },
    {
      "name": "workflow-windows-debug",
      "displayName": "Configure and Build Siv3DApp (Windows, Debug)",
      "steps": [
        {
          "type": "configure",
          "name": "windows-debug"
        },
        {
          "type": "build",
          "name": "build-windows-debug"
        }
      ]
    },
    {
      "name": "workflow-windows-release",
      "displayName": "Configure and Build Siv3DApp (Windows, Release)",
      "steps": [
        {
          "type": "configure",
          "name": "windows-release"
        },
        {
          "type": "build",
          "name": "build-windows-release"
        }
      ]
    }
  ]
}
